# Stalwart JMAP endpoint (localhost listener on the VPS)
JMAP_URL=http://127.0.0.1:8088
MAIL_DOMAIN=hypamail.me
MAIL_HOST=mail.hypamail.me
NEXT_PUBLIC_MAIL_DOMAIN=hypamail.me

# Stalwart management admin (used only server-side; Stalwart >= 0.16 creates
# admin@<domain> during setup)
STALWART_ADMIN_USER=admin@hypamail.me
STALWART_ADMIN_PASS=

# New-account storage quota in bytes (1 GiB)
ACCOUNT_QUOTA_BYTES=1073741824

# Session cookie encryption — 32+ random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Optional: separate key for encrypting stored server-side secrets (internal
# mail credentials, TOTP secrets). Falls back to a subkey of SESSION_SECRET.
#CREDENTIAL_SECRET=

# Cloudflare Turnstile (signup bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Postgres for users, passkeys, invite codes, sessions
DATABASE_URL=postgres://hypamail_web:CHANGEME@127.0.0.1:5432/hypamail_web

# WebAuthn relying party. REQUIRED in production — must be the exact domain the
# app is served from. (In dev these fall back to the request host.)
WEBAUTHN_RP_ID=hypamail.me
WEBAUTHN_ORIGIN=https://hypamail.me
